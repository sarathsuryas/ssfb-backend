# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ssfb?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=604800

# Bootstrap admin (used by `npm run prisma:seed`)
SEED_ADMIN_EMAIL=admin@ssfb.local
SEED_ADMIN_PASSWORD=AdminPass123!
